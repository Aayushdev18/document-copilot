{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "backend/app/**",
      "excludeFiles": "{backend/.venv/**,backend/.pytest_cache/**,backend/.ruff_cache/**,backend/tests/**,backend/**/__pycache__/**,**/*.db}"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|assets/|favicon\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}
