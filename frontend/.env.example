# Backend API. In local dev the Vite server proxies /api to the FastAPI process.
VITE_API_BASE_URL=/api

# local: email session issued by the backend, no Supabase project required.
# supabase: browser auth via Supabase (requires the two variables below).
VITE_AUTH_MODE=local

# Required only when VITE_AUTH_MODE=supabase.
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-public-key
