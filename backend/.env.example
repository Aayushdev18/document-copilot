# Local workspace defaults. Copy to backend/.env.
# AUTH_MODE=local keeps the app runnable without Supabase or OpenAI.
# Switch AUTH_MODE to supabase only after those keys exist — startup fails if they are missing.

DATABASE_URL=sqlite:///./document_copilot.db
AUTH_MODE=local
LOCAL_AUTH_SECRET=change-me
SEED_ON_STARTUP=true
ALLOWED_ORIGINS=http://127.0.0.1:43123,http://localhost:43123

# --- Supabase (required when AUTH_MODE=supabase) ---

# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-anon-public-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Direct Postgres connection for a future Alembic migration against Supabase.
# Do NOT use the transaction pooler URL. URL-encode special characters in the password.
# DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# --- OpenAI (optional). When set, answers are model prose over the retrieved passages. ---
# A missing key keeps the local sentence writer. A set key that fails is an error, not a silent fallback.

# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_DIMENSIONS=1536
